# Line endings: LF in the repository and in working copies on every platform.
# CI, Docker and Hugging Face Spaces run on Linux, and the lock-file integrity
# check compares bytes, so CRLF conversion on Windows checkouts must not occur.
* text=auto eol=lf

*.py text eol=lf
*.pyi text eol=lf
*.toml text eol=lf
*.in text eol=lf
*.txt text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.cfg text eol=lf
*.ini text eol=lf
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.sh text eol=lf
Dockerfile text eol=lf
.env.example text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf
.dockerignore text eol=lf

# Binary assets: never normalise or diff as text.
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.docx binary
