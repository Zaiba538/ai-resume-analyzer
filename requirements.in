# Runtime dependencies for the FastAPI application (backend/).
# Source of truth for top-level pins. The hashed lock (requirements.txt) is
# generated from this file; supported environments are declared in
# pyproject.toml ([tool.uv] environments). Regenerate with (uv 0.13.6):
#
#   uv pip compile requirements.in --universal --python-version 3.12 \
#       --generate-hashes -o requirements.txt
#
# Supported runtimes: CPython 3.12 on Linux x86_64 (Docker, CI, Hugging Face
# Spaces) and Windows AMD64 (local development).

# Web framework
fastapi==0.162.0
