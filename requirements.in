# langchain-groq 1.1.3 requires groq<1.0.0
groq==0.37.1
tenacity==9.2.1

# Embeddings and scoring.
# torch is pinned to CPU-only wheels by direct URL: the PyPI Linux wheel pulls
# in the CUDA toolkit (several GB), and adding the PyTorch index as an extra
# index would let it shadow unrelated PyPI packages (dependency confusion).
torch @ https://download.pytorch.org/whl/cpu/torch-2.15.0%2Bcpu-cp312-cp312-manylinux_2_28_x86_64.whl ; sys_platform == "linux" and platform_machine == "x86_64"
torch @ https://download.pytorch.org/whl/cpu/torch-2.15.0%2Bcpu-cp312-cp312-win_amd64.whl ; sys_platform == "win32" and platform_machine == "AMD64"
sentence-transformers==6.2.0
transformers==5.22.1
numpy==2.5.4
scikit-learn==1.9.1

