# Copy to .env for local development. Never commit .env.
# On Hugging Face Spaces, set GROQ_API_KEY as a Space secret instead.

# Deployment notes (secrets, caches, proxies): see docs/deployment.md.

# Required: Groq API key.
GROQ_API_KEY=

# Log level: DEBUG, INFO, WARNING or ERROR. Logs never contain document text.
LOG_LEVEL=INFO

# Groq models per agent role (verified available on 2026-10-31).
GROQ_MODEL_RESUME=openai/gpt-oss-120b
GROQ_MODEL_SKILL_GAP=openai/gpt-oss-120b
GROQ_MODEL_CRITIC=openai/gpt-oss-120b
GROQ_MODEL_INTERVIEW=openai/gpt-oss-20b
GROQ_MODEL_EVALUATOR=openai/gpt-oss-20b
GROQ_MODEL_PROMPT_GUARD=meta-llama/llama-prompt-guard-2-86m

# Groq availability probe shown by GET /ready: interval (30-3600 s) and timeout
# (up to 30 s). The probe calls GROQ_API_BASE_URL/models; the URL must be https://.
# The probe sends GROQ_API_KEY to this URL, so pointing it at any other host
# exposes the key. Leave it at its default.
GROQ_PROBE_INTERVAL_SECONDS=300
GROQ_PROBE_TIMEOUT_SECONDS=5
# GROQ_API_BASE_URL=https://api.groq.com/openai/v1

# In-memory report retention in seconds (maximum 3600).
REPORT_TTL_SECONDS=3600

# Reports held in memory (1-10000) and how often expired ones are removed (seconds).
MAX_STORED_REPORTS=500
REPORT_SWEEP_INTERVAL_SECONDS=60

# Maximum Critic-driven revision rounds per analysis.
MAX_REVISIONS=1

# Overall deadline for one analysis run, in seconds (1-3600).
ANALYSIS_DEADLINE_SECONDS=600

# LLM calls: timeout, SDK retries, reasoning effort (gpt-oss only), output cap.
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2
LLM_REASONING_EFFORT=low
LLM_MAX_OUTPUT_TOKENS=4096

# Prompt Guard (flag-only). The display threshold is uncalibrated until M12.
PROMPT_GUARD_CHUNK_CHARS=800
PROMPT_GUARD_MAX_CHUNKS=16
PROMPT_GUARD_CONCURRENCY=4
PROMPT_GUARD_DISPLAY_THRESHOLD=0.9

# Upload validation limits.
MAX_UPLOAD_BYTES=5242880
MAX_PDF_PAGES=10
MAX_EXTRACTED_CHARS=50000
MAX_JOB_DESCRIPTION_CHARS=20000

# Interview answers: maximum length in characters (200-20000).
MAX_ANSWER_CHARS=5000

# Overall deadlines of the interview endpoints, in seconds (1-600).
INTERVIEW_DEADLINE_SECONDS=120
EVALUATION_DEADLINE_SECONDS=120

# Sentence-Transformer for semantic similarity, pinned to an exact revision.
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_MODEL_REVISION=1110a243fdf4706b3f48f1d95db1a4f5529b4d41

# Keep third-party tracing disabled: prompts contain resume content.
LANGSMITH_TRACING=false

# Rate limiting (in memory, single process; see docs/rate-limiting.md). Limits use
# the "limits" notation, e.g. 5/minute;30/hour. *_GLOBAL limits are shared by all
# clients; both interview endpoints share RATE_LIMIT_INTERVIEW_GLOBAL.
# RATE_LIMIT_ENABLED=false turns off the quotas only (local development).
RATE_LIMIT_ENABLED=true
RATE_LIMIT_ANALYZE=5/minute;30/hour
RATE_LIMIT_ANALYZE_GLOBAL=20/minute
RATE_LIMIT_INTERVIEW_QUESTIONS=10/minute;60/hour
RATE_LIMIT_INTERVIEW_EVALUATE=20/minute;200/hour
RATE_LIMIT_INTERVIEW_GLOBAL=60/minute
RATE_LIMIT_MATCH=30/minute
RATE_LIMIT_PARSE=30/minute
RATE_LIMIT_REPORT=60/minute
RATE_LIMIT_REPORT_PDF=20/minute
# Per-client keys held by the limiter (100-25000); when full, new clients get 429.
RATE_LIMIT_MAX_TRACKED_KEYS=10000

# Analyses running at the same time (1-8); further requests get 429.
ANALYZE_MAX_CONCURRENT=2

# Document processing shared by /parse, /match and /analyze: documents parsed at
# the same time (1-8; further requests get 503 document_processing_busy) and the
# time a request waits for its document (1-300 s; then 504). The deadline is soft:
# a parse that outlives it keeps running, and keeps its slot, until it finishes.
PARSE_MAX_CONCURRENT=2
PARSE_DEADLINE_SECONDS=30

# HTTP surface.
# API_DOCS_ENABLED=true serves /docs, /redoc and /openapi.json; /docs and /redoc
# are then exempt from the Content Security Policy. Keep false in production.
API_DOCS_ENABLED=false
# CSP frame-ancestors sources (no ';', ',' or newlines). The default,
# 'self' https://huggingface.co, allows embedding in a Hugging Face Space page.
# The value contains spaces and quotes: the quotes below are stripped by the
# app's .env parser, but tools such as `docker run --env-file` keep them
# literally and produce an invalid header. Set it only to change the default,
# and without the outer double quotes when using such tools.
# CSP_FRAME_ANCESTORS="'self' https://huggingface.co"
# Send Strict-Transport-Security. Enable only when the app is served over HTTPS.
HSTS_ENABLED=false
# Directory served at /. The default is the repository's frontend/ directory
# (an absolute path); set it only if the frontend lives elsewhere.
# FRONTEND_DIR=/absolute/path/to/frontend
